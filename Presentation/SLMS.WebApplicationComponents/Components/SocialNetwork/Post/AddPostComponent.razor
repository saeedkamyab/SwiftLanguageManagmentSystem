</div>

@code {
    public CreatePostDto Post { get; set; } = new();

    private async Task CreatePost()
    {
        var post = Post;
        post.PostOwnerId = Guid.Parse("007ed1b0-50a4-4585-a8af-9f36bb896010");
        var success = await PostService.CreatePost(post);

        if (!success)
            return;

        await FeedState.NotifyPostAddedAsync();
        Post = new();

    }

}
