@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SLMS.Dto.Media
@using SLMS.Dto.SocialNetwork.Post
@using SLMS.WebApplicationComponents.Components.Commons
@using SLMS.WebApplicationComponents.Services.Base
@using SLMS.WebApplicationComponents.Services.Base.Interfaces
@using SLMS.WebApplicationComponents.Services.Media.Interface
@using SLMS.WebApplicationComponents.Services.SocialNetwork.Interface
@inject IJSRuntime JS
@inject IPostService PostService
@inject IMediaService MediaService
@inject FeedStateService FeedState
@inject IMediaUrlResolver MediaUrl

<div class="add-post">

    <div class="add-post__body">
        <img class="add-post__avatar" src="/images/profiles/profile.jpg" />
        <EmojiTextInput @bind-Value="Post.Caption"
                        Placeholder="آنچه به ذهنتان میرسد را به اشتراک بگذارید...." />

        

    </div>
    <div class="add-post__Media-preview">
        @if (isUploading)
        {
            <p>در حال آپلود... @uploadProgress%</p>
        }
        else if (uploadedMedia.ContentType.StartsWith("video/"))
        {
            <video class="media-img"
                   muted
                   playsinline
                   onmouseover="this.play()"
                   onmouseout="this.pause(); this.currentTime=0;">
                <source src="@MediaUrl.Resolve(uploadedMedia.FileUrl)" type="@uploadedMedia.ContentType">
            </video>
        }
        else if (uploadedMedia.ContentType.StartsWith("image/"))
        {
            <img src="@MediaUrl.Resolve(uploadedMedia.FileUrl)" />

        }
    </div>
    <div class="add-post__Seprater"></div>

    <div class="add-post__actions">

        <label for="postImageInput" class="add-post__action" data-tooltip="تصویر/ویدیو">
