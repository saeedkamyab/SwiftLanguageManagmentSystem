            </svg>
            <span class="add-post__action-text">نظرسنجی</span>
        </button>

        <button class="add-post__action post__action--Share" @onclick="CreatePost">
            <span class="add-post__action-text">اشتراک گذاری</span>
        </button>

    </div>

  

</div>

@code {
    public CreatePostDto Post { get; set; } = new();
    private bool isUploading;
    private int uploadProgress;
    // private List<MediaAssetDto> uploadedMedias = new();
    private MediaAssetDto uploadedMedia = new();

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        // var files = e.GetMultipleFiles(3);
        var file = e.File;

        // foreach (var file in files)
        // {
        var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024));
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "file", file.Name);
        var response = await MediaService.UploadFileAsync(content);
        if (response.IsSuccessStatusCode)
        {
            var mediaDto = await response.Content.ReadFromJsonAsync<MediaAssetDto>();
            if (mediaDto != null)
            {
                //uploadedMedias.Add(mediaDto);
                uploadedMedia = mediaDto;
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Upload failed: {response.StatusCode} - {error}");
        }
        // }
        isUploading = false;
    }

   


    private async Task CreatePost()
    {
        var post = Post;
        post.PostOwnerId = Guid.Parse("007ed1b0-50a4-4585-a8af-9f36bb896010");
        var success = await PostService.CreatePost(post);

        if (!success)
            return;

        await FeedState.NotifyPostAddedAsync();
        Post = new();

    }

}
