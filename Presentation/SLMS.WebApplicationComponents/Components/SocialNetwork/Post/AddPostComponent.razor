            </svg>
            <span class="add-post__action-text">تصویر/ویدیو</span>
        </label>

        <InputFile id="postImageInput" style="display:none" accept="image/*,video/*"
                   multiple OnChange="HandleFileSelected" />

     
        <button class="add-post__action" data-tooltip="نظرسنجی">
            <svg class="add-post__icon" viewBox="0 0 26 26" width="20" height="20">
