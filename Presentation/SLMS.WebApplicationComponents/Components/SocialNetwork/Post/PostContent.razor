@using SLMS.Dto.SocialNetwork
@using SLMS.WebApplicationComponents.Services.Base.Interfaces
@inject IMediaUrlResolver MediaUrl

<div class="post__content">
    <div class="post__caption">@Post.Caption</div>
    @if (Post.PostMedia != null && Post.PostMedia.MediaAsset != null)
    {
        if (Post.PostMedia.MediaAsset.ContentType.StartsWith("video/"))
        {
            <video class="post__image"
                   muted
                   playsinline
                   controls>
                <source src="@MediaUrl.Resolve(Post.PostMedia.MediaAsset.FileUrl)" type="@Post.PostMedia.MediaAsset.ContentType">
            </video>
        }
        else if (Post.PostMedia.MediaAsset.ContentType.StartsWith("image/"))
        {
            <img class="post__image" src="@MediaUrl.Resolve(Post.PostMedia.MediaAsset.FileUrl)" />

        }
    }

</div>
@code {
    [Parameter]
    public PostSummaryDto Post { get; set; }
}
