@using SLMS.Dto.SocialNetwork
@using SLMS.Shared.Enums
@using SLMS.WebApplication.Services
@using SLMS.WebApplicationComponents.Components.Commons
@using SLMS.WebApplicationComponents.Services.Base
@using SLMS.WebApplicationComponents.Services.SocialNetwork.Interface
@inject IPostService PostService
@inject SearchStateService SearchService
@inject FeedStateService FeedState

<div class="post-filters">
    <button class="post-filter__action @(currentFilter == PostFilter.All ? "post-filter__action--active" : "")" @onclick="() => LoadPosts(PostFilter.All)">
        <span class="post-filter__action-text">همه پست ها</span>
    </button>
    <button class="post-filter__action @(currentFilter == PostFilter.Followings ? "post-filter__action--active" : "")" @onclick="() => LoadPosts(PostFilter.Followings)">
        <span class="post-filter__action-text">دنبال شوندگان</span>
    </button>
    @*     <button class="post-filter__action @(currentFilter == PostFilter.Ads ? "post-filter__action--active" : "")" @onclick="() => LoadPosts(PostFilter.Ads)">
        <span class="post-filter__action-text">آگهی ها</span>
    </button> *@

    <SortDropdown />
</div>

@if (posts == null)
{
    <p>Loading...</p>
}
else
{
    @foreach (var post in posts.Items)
    {
        <PostItem Post="post" />
    }
}
<button class="mobile-add-post-btn" @onclick="() => showModal = true">
    <svg viewBox="0 0 26 26" width="30" height="30">
        <path d="M12 3C11.398438 3 11 3.398438 11 4L11 11L4 11C3.398438 11 3 11.398438 3 12L3 14C3 14.601563 3.398438 15 4 15L11 15L11 22C11 22.601563 11.398438 23 12 23L14 23C14.601563 23 15 22.601563 15 22L15 15L22 15C22.601563 15 23 14.601563 23 14L23 12C23 11.398438 22.601563 11 22 11L15 11L15 4C15 3.398438 14.601563 3 14 3Z" fill="currentColor" />
    </svg>
</button>

<Modal @bind-IsVisible="showModal">
    <AddPostComponent />
</Modal>

@code {
    private PostFilter currentFilter = PostFilter.All;
    private bool showModal;
    private PagedResult<PostSummaryDto> posts;
    private PostListQuery _query = new() { PageNumber = 1, PageSize = 10 };


    protected override async Task OnInitializedAsync()
    {
        await LoadPosts(PostFilter.All);
        FeedState.OnPostAdded += HandlePostAdded;

    }
    protected async Task LoadPosts(PostFilter postFilter)
    {
        SearchService.OnChange += HandleSearchChanged;
        currentFilter = postFilter;
        _query.OnlyMyFollowings = (postFilter == PostFilter.Followings) ? true : false;
        posts = await PostService.GetAllPostsAsync(_query);
    }
    private async void HandleSearchChanged()
    {
        // آپدیت کوئری با کلمه جدید
        _query.SearchTerm = SearchService.SearchTerm;
        _query.PageNumber = 1;
        await LoadPosts(PostFilter.All);
        StateHasChanged();
    }
    private async Task HandlePostAdded()
    {
        await LoadPosts(PostFilter.All);
        StateHasChanged(); // آپدیت UI
    }
    public async ValueTask DisposeAsync()
    {
        FeedState.OnPostAdded -= HandlePostAdded; // جلوگیری از memory leak
        // برای جلوگیری از Memory Leak
        SearchService.OnChange -= HandleSearchChanged;
    }
}
