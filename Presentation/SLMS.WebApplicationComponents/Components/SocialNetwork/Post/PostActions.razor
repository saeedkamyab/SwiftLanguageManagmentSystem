    <button class="post__action post__action--bookmark @(Post.IsBookmarkedByCurrentUser ? "post__action--active" : "")" @onclick="() => ToggleBookmark(Post)">
        <svg class="post__icon" viewBox="0 0 26 26" width="20" height="20">
