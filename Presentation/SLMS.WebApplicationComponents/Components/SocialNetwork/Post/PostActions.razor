        </svg>
        <span class="post__count">@Post.BookmarksCount</span>
    </button>
</div>
@code {
    [Parameter]
    public PostSummaryDto Post { get; set; }
    [Parameter]
    public EventCallback OnCommentsClick { get; set; }

    private async Task OnCommentClicked()
    {
        if (OnCommentsClick.HasDelegate)
            await OnCommentsClick.InvokeAsync();
    }
    private async Task ToggleLike(PostSummaryDto post)
    {

        var previousState = post.IsLikedByCurrentUser;

        post.IsLikedByCurrentUser = !post.IsLikedByCurrentUser;
        post.LikesCount += post.IsLikedByCurrentUser ? 1 : -1;

        try
        {
            await PostService.ToggleLikeAsync(post.Id);
        }
        catch
        {
            // rollback UI
            post.IsLikedByCurrentUser = previousState;
            post.LikesCount += post.IsLikedByCurrentUser ? 1 : -1;
        }
    }
    private async Task ToggleBookmark(PostSummaryDto post)
    {

        var previousState = post.IsBookmarkedByCurrentUser;

        post.IsBookmarkedByCurrentUser = !post.IsBookmarkedByCurrentUser;
        post.BookmarksCount += post.IsBookmarkedByCurrentUser ? 1 : -1;

        try
        {
            await PostService.ToggleBookmarkAsync(post.Id);
        }
        catch
        {
            // rollback UI
            post.IsBookmarkedByCurrentUser = previousState;
            post.BookmarksCount += post.IsBookmarkedByCurrentUser ? 1 : -1;
        }
    }
}
