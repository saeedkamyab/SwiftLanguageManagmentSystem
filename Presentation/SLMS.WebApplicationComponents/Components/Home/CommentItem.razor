@using SLMS.Dto.SocialNetwork.Comments
@using SLMS.Shared.Extensions
<div class="comment">

    <img class="comment__image" src="images/profiles/@Comment.User.ProfileImageUrl" />

    <div class="comment__content">

        <div class="comment__meta">
            <span class="comment__UserFirstLastName">
                @Comment.User.FirstName @Comment.User.LastName
            </span>

            <span class="comment__datetime">
                @Comment.CreateDate.ToTimeAgo()
            </span>
        </div>

        <div class="comment__context">
            <span>@Comment.CommentContext</span>
        </div>
        <div class="comment__actions">
            <button class="comment__action" >
                <svg class="comment__icon" viewBox="0 0 26 26" width="20" height="20">
                    <path d="M14.570313 1.042969C15.449219 2.503906 14.453125 4.332031 13.710938 5.925781C13.070313 7.296875 13.167969 8.851563 14.882813 8.652344C16.949219 8.414063 17.785156 8.25 19.542969 8.128906C21.320313 8.007813 21.878906 8.734375 21.878906 9.410156C21.878906 10.5 21.515625 10.582031 21.515625 11C21.515625 11.417969 22.878906 11.148438 22.878906 12.519531C22.878906 13.890625 21.8125 13.847656 21.8125 14.230469C21.8125 14.613281 22.851563 14.785156 22.851563 15.882813C22.851563 16.980469 21.453125 17.125 21.453125 17.578125C21.453125 18.03125 21.90625 18.148438 21.90625 18.828125C21.90625 19.507813 20.488281 21 15.488281 21C6.96875 21 7.976563 18.960938 4 18.960938L4 11.417969C6.070313 11.417969 5.957031 9.585938 7.386719 8.1875C8.828125 6.777344 11.585938 3.582031 12.128906 1.0625C12.488281 -0.625 14.03125 0.140625 14.570313 1.042969Z" fill="currentColor" />
                </svg>
                <span class="comment__count"></span>
            </button>
            <button class="comment__action " >
                <svg viewBox="0 0 26 26" width="20" height="20">
                    <path d="M13 0.1875C5.925781 0.1875 0.1875 5.253906 0.1875 11.5C0.1875 14.667969 1.667969 17.527344 4.042969 19.582031C3.523438 22.59375 0.160156 23.8125 0.390625 24.640625C3.230469 25.816406 8.921875 23.230469 10.308594 22.558594C11.179688 22.722656 12.078125 22.8125 13 22.8125C20.074219 22.8125 25.8125 17.75 25.8125 11.5C25.8125 5.25 20.074219 0.1875 13 0.1875 Z M 18.601563 17.488281C18.917969 13.203125 16.828125 12.027344 12.058594 12.027344L12.058594 13.945313C12.058594 14.097656 11.976563 14.230469 11.835938 14.289063C11.785156 14.308594 11.738281 14.316406 11.691406 14.316406C11.59375 14.316406 11.5 14.28125 11.425781 14.207031L6.964844 10.71875C6.820313 10.574219 6.820313 10.335938 6.964844 10.191406L11.429688 6.6875C11.535156 6.582031 11.695313 6.546875 11.835938 6.605469C11.976563 6.664063 12.058594 6.800781 12.058594 6.949219L12.058594 8.988281C16.742188 8.988281 20.621094 10.632813 18.601563 17.488281Z" fill="currentcolor" />
                </svg>
            </button>
        </div>

    </div>

</div>

@if (Comment.ChildComments != null && Comment.ChildComments.Any())
{
    <div class="comment__children">

        @foreach (var child in Comment.ChildComments)
        {
            <CommentItem Comment="child" />
        }

    </div>
}

@code {

    [Parameter]
    public CommentDto Comment { get; set; }

}

